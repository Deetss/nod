<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <include android:id="@+id/header" layout="@layout/header_step" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/method_paste_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/paste_body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/field"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/bg_default"
            app:boxCornerRadiusBottomEnd="4dp"
            app:boxCornerRadiusBottomStart="4dp"
            app:boxCornerRadiusTopEnd="4dp"
            app:boxCornerRadiusTopStart="4dp"
            app:boxStrokeColor="@color/field_stroke"
            app:boxStrokeErrorColor="@color/border_danger"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:cursorColor="@color/fg_accent"
            app:expandedHintEnabled="false"
            app:hintTextAppearance="@style/Text.Caption"
            app:hintTextColor="@color/fg_accent"
            android:textColorHint="@color/fg_muted"
            app:placeholderTextColor="@color/fg_muted"
                android:layout_marginTop="18dp"
                android:hint="@string/link_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textMultiLine"
                    android:minHeight="84dp"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/paste"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/paste_clipboard"
                android:textAppearance="@style/Text.CaptionSemibold"
                android:textColor="@color/fg_default"
                app:chipBackgroundColor="@color/btn_default_bg"
                app:chipCornerRadius="8dp"
                app:chipIcon="@drawable/ic_clipboard"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/fg_default"
                app:chipMinHeight="32dp"
                app:chipStrokeColor="@color/border_default"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="true" />

            <LinearLayout
                android:id="@+id/found"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_check_done"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/fg_on_emphasis" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/host_found" />

                    <TextView
                        android:id="@+id/found_host"
                        style="@style/Text.TitleSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/check"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:text="@string/check_server" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
